# Visual Studio Code .gitignore for C++ projects

# Build directories
build/
bin/
obj/
out/

# Visual Studio
.vs/
*.sln
*.vcxproj
*.vcxproj.filters
*.vcxproj.user
.vscode/
*.code-workspace

# CMake
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
CMakeLists.txt.user

# Build artifacts
*.o
*.a
*.lib
*.so
*.dylib
*.dll
*.exe
*.out
*.pdb
*.ilk
*.exp
*.res

# Compiler outputs
*.obj
*.d
*.su
*.gch
*.pc

# IDE and Editor
.vscode/
.idea/
*.swp
*.swo
*.swn
*~
.DS_Store
Thumbs.db

# Logs
logs/
*.log
*.log.*

# Temporary files
*.tmp
*.temp
*.bak
*.swp
*~

# Dependencies
deps/
vendor/
external/
third_party/

# User-specific files
*.user
*.userosscache
*.sln.docstates

# Backup files
*.backup
*.orig

# OS
.DS_Store
Thumbs.db
desktop.ini

# Python
__pycache__/
*.py[cod]
*$py.class
.python-version
venv/

# Configuration files (keep defaults, ignore local)
local_config.json
.env.local

# Generated documentation
docs/_build/
docs/generated/

# Backups directory
backups/

# Profiling data
*.prof
*.stats
